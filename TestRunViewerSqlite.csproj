<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.6.0</Version>
    <ApplicationIcon>Resources\TAP_Explorer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Made from TAP_Explorer.png: the icon is the rounded square with a transparent background -->
    <EmbeddedResource Include="Resources\TAP_Explorer.ico" LogicalName="TAP_Explorer.ico" />
    <EmbeddedResource Include="Resources\TAP_Explorer_splash.png" LogicalName="TAP_Explorer_splash.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.14" />
    <PackageReference Include="ClosedXML" Version="0.103.0" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
  </ItemGroup>
</Project>
